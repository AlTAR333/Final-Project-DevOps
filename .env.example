# Placeholders only. Copy to .env (gitignored) and change the values.
APP_ENV=test
LOG_LEVEL=INFO
API_PORT=8080

POSTGRES_USER=fulfillops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fulfillops_test
# For tools run on your own machine (reset script, integration tests): Postgres is published on
# 127.0.0.1:5432. Inside Compose the containers build their own URL (host `db`) from the
# POSTGRES_* values above, so keep the password URL-safe (letters and digits).
DATABASE_URL=postgresql://fulfillops:change-me@localhost:5432/fulfillops_test

# Optional: tag for the locally built images (CI uses the commit SHA)
# IMAGE_TAG=local

# Worker
POLL_INTERVAL_SECONDS=0.5
LEASE_SECONDS=30
MAX_ATTEMPTS=5
BACKOFF_BASE_SECONDS=1
BACKOFF_CAP_SECONDS=60

# Lab-only fault injection
PROCESSING_DELAY_SECONDS=0
FAULT_INJECTION_ENABLED=false
